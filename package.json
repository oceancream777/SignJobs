  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/jsdom": "21.1.7",
    "@types/webextension-polyfill": "0.12.3",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "playwright": "1.62.1"
  }
}
